# ==========================================
# DAAM - Repository-wide Git Ignore
# ==========================================

# -------------------------
# Operating System
# -------------------------
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini

# -------------------------
# IDE / Editors
# -------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn
*.bak
*.tmp

# -------------------------
# Node.js
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Environment Variables
# -------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Keep example environment files
!.env.example

# -------------------------
# Build / Distribution
# -------------------------
dist/
build/
out/
coverage/
.cache/
.parcel-cache/
.vite/

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# Runtime / Temporary
# -------------------------
*.pid
*.pid.lock
*.seed

# -------------------------
# Test / Coverage
# -------------------------
.nyc_output/
coverage/

# -------------------------
# Hardhat / Solidity
# -------------------------
artifacts/
cache/
typechain/
typechain-types/

# -------------------------
# Local Blockchain Data
# -------------------------
*.db
*.sqlite
*.sqlite3

# -------------------------
# Generated Files
# -------------------------
*.generated.*
*.local.*

# -------------------------
# Secrets / Keys
# -------------------------
*.pem
*.key
*.p12
*.pfx

# Never commit private keys
private-key.txt
secrets/